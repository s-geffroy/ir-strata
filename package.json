{
  "name": "ir-strata",
  "version": "1.0.0-atlas-v1",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "npm run prebuild && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "validate:data": "python3 scripts/validate_model.py",
    "generate:data": "python3 scripts/compute_scores.py && python3 scripts/generate_exports.py",
    "generate:docs": "python3 scripts/generate_mdx.py && python3 scripts/calibration_report.py",
    "prebuild": "npm run validate:data && npm run generate:data && npm run generate:docs",
    "check:data": "python3 scripts/validate_model.py && python3 scripts/audit_anachronism.py --check && python3 scripts/enforce_maturity_policy.py --check",
    "audit:refs": "python3 scripts/audit_references.py --check",
    "data:refresh": "python3 scripts/audit_anachronism.py --write && python3 scripts/enforce_maturity_policy.py --write && python3 scripts/audit_references.py --write && python3 scripts/build_site.py"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0"
  }
}
